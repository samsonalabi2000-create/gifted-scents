# DEVELOPMENT ONLY. Mock data is ignored (and a warning shown) in production builds.
VITE_USE_MOCK=false
# Leave empty in dev (Vite proxies /api to the server). In production set the full API URL, e.g. https://api.yourdomain.com/api
VITE_API_URL=
# Public site URL used for canonical links / structured data
VITE_SITE_URL=http://localhost:5173
