{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://YOUR-API-DOMAIN.example/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
