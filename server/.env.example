# ============ Gifted Scents API - environment (copy to .env, never commit .env) ============
NODE_ENV=development
PORT=5000
# Public URL of the website (used for CORS, payment callback, emails, sitemap)
CLIENT_URL=http://localhost:5173
# Public URL of THIS api (used to build image URLs in local-storage mode)
SERVER_URL=http://localhost:5000
# Extra allowed browser origins, comma separated (defaults to CLIENT_URL)
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gifted_scents?schema=public

# ---- Auth: generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# lax = same site (recommended: serve API on a sub-path/sub-domain of the site). none = site and API on different domains.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Paystack (secret key lives ONLY here, never in the client) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional. Paystack signs webhooks with your secret key, so leave empty unless you front it with a proxy.
PAYSTACK_WEBHOOK_SECRET=

# ---- AI assistant (works without a key in "grounded fallback" mode) ----
AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible API) | none
AI_API_KEY=
AI_MODEL=                      # blank = sensible default for the provider
AI_BASE_URL=                   # only for self-hosted / compatible providers

# ---- Image storage ----
STORAGE_PROVIDER=local         # local | cloudinary | s3
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=                   # blank for AWS; set for Cloudflare R2 / Backblaze / MinIO
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=            # public URL prefix of the bucket / CDN

# ---- Transactional email (console = prints to the log, nothing is sent) ----
EMAIL_PROVIDER=console         # console | resend
EMAIL_API_KEY=
EMAIL_FROM=Gifted Scents <no-reply@yourdomain.com>

# Fallback if the WhatsApp number is not yet set in Admin > Settings (digits, country code)
WHATSAPP_NUMBER=
