{
  "name": "gifted-scents-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "node scripts/lint.js",
    "test": "node --import ./tests/helpers/register.mjs --test \"tests/unit/*.test.js\"",
    "test:integration": "node --import ./tests/helpers/register-none.mjs --test \"tests/integration/*.test.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:search": "node scripts/apply-search-sql.js",
    "db:seed": "node prisma/seed.js",
    "db:clear-demo": "node scripts/clear-demo.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "cloudinary": "^2.5.1"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2",
    "prisma": "^6.0.0"
  }
}
